#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# partiduo-agent-instance — enveloppe des gestes que l'exécutant fait sous le
# compte des instances (`partiduo`), seule commande que sudoers lui permet
# sous ce compte (deploy/partiduo-agent.sudoers, D-AFN-002). Serveur
# FreeBSD : instances servies par le paquet partiduo-app ou partiduo-app-devel,
# exclusifs l'un de l'autre et installés aux mêmes emplacements
# (/usr/local/lib/partiduo).
#
# Installée par root en 0755, possédée par root, dans
# /usr/local/libexec/partiduo-agent/. Chaque argument est validé ici ; tout
# le reste (répertoires, domaine, rôle propriétaire, socket) vient de la
# configuration possédée par root /usr/local/etc/partiduo-agent/helpers.conf.
# Aucun argument n'est jamais évalué par un shell.
#
#   cli SLUG BASE|- PAQUET|- ACTION [ARGUMENTS…]    partiduo-manage instance ACTION
#                                                   (PAQUET : app, devel, ou « - » : instance déclarée)
#   provision SLUG [OPTIONS…] --package app|devel   partiduo-provision du paquet (options permises seulement)
#   db-exists BASE                                  code 0 si la base existe, 3 sinon
#   createdb BASE | dropdb BASE                     base du rôle des instances
#   dump BASE CHEMIN|- | restore BASE CHEMIN|-      pg_dump -Fc / pg_restore (chemins sous BACKUP_DIR ;
#                                                   « - » : sortie ou entrée standard, sauvegardes chiffrées)
#   backup-dir SLUG                                 répertoire de sauvegarde du dossier
#   media-archive SLUG LISTE ARCHIVE|-              archive des pièces jointes
#   media-restore SLUG ARCHIVE|-                    pièces jointes remises en place
#
# Paquet d'une instance : celui installé sur le serveur (pkg, lisible sans
# root). Un paquet explicite (création, restauration en instance neuve) doit
# être celui-là ; sans paquet explicite (« - »), l'instance doit être
# déclarée dans partiduo_instances (rc.conf, lisible sans root). Sinon :
# refus.
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 027

die() {
  echo "partiduo-agent-instance : $*" >&2
  exit 2
}

# --- Configuration (possédée par root) -----------------------------------------

CONF=/usr/local/etc/partiduo-agent/helpers.conf
# Essais (specs) : autre configuration, jamais sous sudo (sudo efface
# l'environnement et pose SUDO_USER).
if [ -n "${PARTIDUO_AGENT_HELPERS_CONF:-}" ] && [ -z "${SUDO_USER:-}" ]; then
  CONF="$PARTIDUO_AGENT_HELPERS_CONF"
else
  # stat -f : FreeBSD (et macOS).
  [ "$(stat -f %u "$CONF" 2>/dev/null || echo x)" = 0 ] || die "configuration absente ou non possédée par root : $CONF"
fi
DOMAIN=""
ETC_DIR=/usr/local/etc/partiduo
DATA_DIR=/var/db/partiduo
SYSTEM_USER=partiduo
PG_OWNER=partiduo
PG_SOCKET=/tmp
BACKUP_DIR=/var/backups/partiduo
STAGE_DIR=/var/db/partiduo-stage
ACME_EMAIL=""
ACME_WEBROOT=/usr/local/www/letsencrypt
ACME_STAGING=0
# Outils, par chemin absolu (surchargeables pour les essais seulement).
SYSRC=/usr/sbin/sysrc
PKG=/usr/sbin/pkg
PSQL=/usr/local/bin/psql
CREATEDB=/usr/local/bin/createdb
DROPDB=/usr/local/bin/dropdb
PG_DUMP=/usr/local/bin/pg_dump
PG_RESTORE=/usr/local/bin/pg_restore
TAR=/usr/bin/tar
# Essais : préfixe des chemins système (/usr/local/lib). Vide en production.
SYSTEM_ROOT=""
# shellcheck disable=SC1090
. "$CONF"
export PGHOST="$PG_SOCKET"
LIB_DIR="$SYSTEM_ROOT/usr/local/lib"

# --- Validation ------------------------------------------------------------------

check_slug() {
  printf '%s' "$1" | grep -Eq '^[a-z][a-z0-9-]{0,39}$' || die "sous-domaine invalide"
  case "$1" in *-) die "sous-domaine invalide" ;; admin | www | rt-*) die "sous-domaine réservé" ;; esac
}

check_database() {
  printf '%s' "$1" | grep -Eq '^partiduo_[a-z0-9_]{1,54}$' || die "base refusée"
  [ "$1" != partiduo_admin ] || die "base refusée"
}

# Chemin de sauvegarde : sous BACKUP_DIR, sans « .. », caractères sûrs.
check_backup_path() {
  printf '%s' "$1" | grep -Eq '^/[A-Za-z0-9_./-]+$' || die "chemin refusé"
  case "$1" in "$BACKUP_DIR"/*) ;; *) die "chemin hors du répertoire des sauvegardes" ;; esac
  case "/$1/" in */../* | */./*) die "chemin refusé" ;; esac
}

media_root() { echo "$DATA_DIR/$1/media"; }

# --- Paquet d'une instance (pkg, rc.conf) ----------------------------------------

# Valeur d'une variable de rc.conf ; vide si elle n'est pas définie.
rc_value() {
  "$SYSRC" -n "$1" 2>/dev/null | tr '\t\n' '  ' || true
}

# Paquet installé sur le serveur : app (partiduo-app) ou devel
# (partiduo-app-devel). Les deux s'excluent et s'installent aux mêmes
# emplacements : une seule version par serveur.
installed_package() {
  if "$PKG" info -q -e partiduo-app-devel; then
    echo devel
  elif "$PKG" info -q -e partiduo-app; then
    echo app
  else
    die "ni partiduo-app ni partiduo-app-devel n'est installé"
  fi
}

# Paquet qui sert l'instance $1 : celui du serveur ; $2 : paquet attendu
# (app, devel) ou « - » (instance déclarée dans partiduo_instances).
resolve_package() {
  explicit="$2"
  case "$explicit" in app | devel | -) ;; *) die "paquet refusé" ;; esac
  installed=$(installed_package) || exit 2
  if [ "$explicit" = - ]; then
    case " $(rc_value partiduo_instances) " in
      *" $1 "*) ;;
      *) die "instance non déclarée dans rc.conf : $1" ;;
    esac
  else
    [ "$explicit" = "$installed" ] || die "paquet $explicit absent du serveur (paquet installé : $installed)"
  fi
  echo "$installed"
}

# Répertoire des paquets, le même pour app et devel (bin/partiduo-manage,
# bin/partiduo-provision, deploy/templates), installé par pkg et possédé par
# root.
PACKAGE_DIR="$LIB_DIR/partiduo"

# --- Gestes ----------------------------------------------------------------------

[ $# -ge 1 ] || die "usage : cli | provision | db-exists | createdb | dropdb | dump | restore | backup-dir | media-archive | media-restore"
command="$1"
shift

case "$command" in
  cli)
    [ $# -ge 4 ] || die "usage : cli SLUG BASE|- PAQUET|- ACTION [ARGUMENTS…]"
    slug="$1" database="$2" package="$3" action="$4"
    shift 4
    check_slug "$slug"
    case "$action" in
      version | status | migrations | migrate | enable | disable | read-only | admin-invite | backup-plan) ;;
      *) die "action refusée" ;;
    esac
    # Seule option qui écrit un fichier : sous BACKUP_DIR seulement.
    expect_path=0
    for arg in "$@"; do
      if [ "$expect_path" = 1 ]; then check_backup_path "$arg"; expect_path=0; continue; fi
      case "$arg" in
        --list-file) expect_path=1 ;;
        --list-file=*) check_backup_path "${arg#--list-file=}" ;;
      esac
    done
    [ "$expect_path" = 0 ] || die "--list-file : chemin manquant"
    resolve_package "$slug" "$package" >/dev/null || exit 2
    manage="$PACKAGE_DIR/bin/partiduo-manage"
    env_file="$ETC_DIR/$slug.env"
    if [ -f "$env_file" ]; then
      set -a
      # shellcheck disable=SC1090 # écrit par root après validation (partiduo-agent-root install)
      . "$env_file"
      set +a
    fi
    if [ "$database" != - ]; then
      check_database "$database"
      DATABASE_URL="postgres:///$database?host=$PG_SOCKET"
      export DATABASE_URL
    fi
    exec "$manage" instance "$action" "$@"
    ;;

  provision)
    [ $# -ge 1 ] || die "usage : provision SLUG [OPTIONS…] --package app|devel"
    slug="$1"
    shift
    check_slug "$slug"
    [ -n "$DOMAIN" ] || die "DOMAIN manquant dans $CONF"
    package=""
    set -- "$@" --end--
    while [ "$1" != --end-- ]; do
      option="$1"
      shift
      case "$option" in
        --skip-createdb | --files-only) set -- "$@" "$option" ;;
        --name | --admin-email | --siren | --vat)
          [ "$1" != --end-- ] || die "$option : valeur manquante"
          set -- "$@" "$option=$1"
          shift
          ;;
        --regime)
          case "$1" in fr | be) ;; *) die "régime refusé" ;; esac
          set -- "$@" "$option=$1"
          shift
          ;;
        --locale)
          case "$1" in fr | en | nl) ;; *) die "langue refusée" ;; esac
          set -- "$@" "$option=$1"
          shift
          ;;
        --modules | --with)
          printf '%s' "$1" | grep -Eq '^([a-z][a-z0-9_]*(,[a-z][a-z0-9_]*)*)?$' || die "codes refusés"
          set -- "$@" "$option=$1"
          shift
          ;;
        --package)
          case "$1" in app | devel) package="$1" ;; *) die "paquet refusé" ;; esac
          shift
          ;;
        *) die "option refusée : $option" ;;
      esac
    done
    shift
    [ -n "$package" ] || die "--package manquant"
    # Paquet attendu absent du serveur : refus.
    resolve_package "$slug" "$package" >/dev/null || exit 2
    dir=$PACKAGE_DIR
    acme=""
    [ -z "$ACME_EMAIL" ] || acme="--acme-email=$ACME_EMAIL"
    staging=""
    [ "$ACME_STAGING" = 0 ] || staging="--acme-staging"
    mkdir -p "$STAGE_DIR"
    # Base : celle du sous-domaine, propriété du rôle des instances. Les
    # gabarits sont ceux du paquet (partiduo-provision les trouve dans
    # ../deploy/templates).
    database="partiduo_$(printf '%s' "$slug" | tr '-' '_')"
    exec "$dir/bin/partiduo-provision" --version="$package" --domain="$DOMAIN" --owner="$PG_OWNER" \
      --database="$database" --pg-socket="$PG_SOCKET" --data-dir="$DATA_DIR" --etc-dir="$ETC_DIR" \
      --system-user="$SYSTEM_USER" --output-dir="$STAGE_DIR" --manage="$dir/bin/partiduo-manage" \
      --acme-webroot="$ACME_WEBROOT" ${acme:+"$acme"} ${staging:+"$staging"} "$@" "$slug"
    ;;

  db-exists)
    [ $# -eq 1 ] || die "usage : db-exists BASE"
    check_database "$1"
    found=$("$PSQL" -X -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname = '$1'")
    [ "$found" = 1 ] && exit 0
    exit 3
    ;;

  createdb)
    [ $# -eq 1 ] || die "usage : createdb BASE"
    check_database "$1"
    exec "$CREATEDB" --owner="$PG_OWNER" --encoding=UTF8 "$1"
    ;;

  dropdb)
    [ $# -eq 1 ] || die "usage : dropdb BASE"
    check_database "$1"
    exec "$DROPDB" --if-exists "$1"
    ;;

  dump)
    [ $# -eq 2 ] || die "usage : dump BASE CHEMIN|-"
    check_database "$1"
    # « - » : sortie standard, chiffrée par l'exécutant (D-CHF-004). exec :
    # le code de sortie de pg_dump est celui de l'enveloppe.
    [ "$2" = - ] && exec "$PG_DUMP" -Fc --no-owner "$1"
    check_backup_path "$2"
    exec "$PG_DUMP" -Fc --no-owner -f "$2" "$1"
    ;;

  restore)
    [ $# -eq 2 ] || die "usage : restore BASE CHEMIN|-"
    check_database "$1"
    # « - » : entrée standard, déchiffrée par l'exécutant (D-CHF-004).
    [ "$2" = - ] && exec "$PG_RESTORE" --no-owner --exit-on-error -d "$1"
    check_backup_path "$2"
    exec "$PG_RESTORE" --no-owner --exit-on-error -d "$1" "$2"
    ;;

  backup-dir)
    [ $# -eq 1 ] || die "usage : backup-dir SLUG"
    check_slug "$1"
    # BSD : un répertoire créé prend toujours le groupe de son parent
    # (BACKUP_DIR, partiduo:partiduo-agent 0770), sans bit setgid ; les deux
    # comptes y écrivent, l'exécutant relit, vérifie et efface les
    # sauvegardes.
    mkdir -p "$BACKUP_DIR/$1"
    exec chmod 770 "$BACKUP_DIR/$1"
    ;;

  media-archive)
    [ $# -eq 3 ] || die "usage : media-archive SLUG LISTE ARCHIVE|-"
    check_slug "$1"
    check_backup_path "$2"
    # « - » : sortie standard, chiffrée par l'exécutant (D-CHF-004).
    [ "$3" = - ] || check_backup_path "$3"
    root=$(media_root "$1")
    # Chemins relatifs au stockage de l'instance seulement : ni absolu, ni
    # « .. », ni option, ni caractère de contrôle (D-CRA-004).
    if [ -f "$2" ] && { grep -Eq '^/|^-|(^|/)\.\.(/|$)|//' "$2" || LC_ALL=C grep -q '[[:cntrl:]]' "$2"; }; then
      die "liste refusée : chemin hors du stockage des pièces jointes"
    fi
    if [ ! -d "$root" ] || [ ! -s "$2" ]; then
      # Aucune pièce jointe : archive vide, pour une sauvegarde homogène.
      exec "$TAR" -czf "$3" -T /dev/null
    fi
    # bsdtar n'a pas --ignore-failed-read : la liste (relevée avant et
    # après pg_dump, D-AFN-012) est réduite aux pièces encore présentes ;
    # une pièce effacée entre ce tri et l'archivage fait échouer tar, et
    # la sauvegarde avec lui, plutôt qu'une archive incomplète en silence.
    present=$(mktemp "${TMPDIR:-/tmp}/partiduo-liste.XXXXXX")
    trap 'rm -f "$present"' EXIT
    while IFS= read -r entry || [ -n "$entry" ]; do
      [ -n "$entry" ] || continue
      if [ -e "$root/$entry" ] || [ -L "$root/$entry" ]; then printf '%s\n' "$entry"; fi
    done <"$2" >"$present"
    if [ ! -s "$present" ]; then
      "$TAR" -czf "$3" -T /dev/null
    else
      "$TAR" -C "$root" -czf "$3" -T "$present"
    fi
    ;;

  media-restore)
    [ $# -eq 2 ] || die "usage : media-restore SLUG ARCHIVE|-"
    check_slug "$1"
    # « - » : entrée standard, déchiffrée par l'exécutant (D-CHF-004).
    [ "$2" = - ] || check_backup_path "$2"
    root=$(media_root "$1")
    mkdir -p "$root"
    exec "$TAR" -C "$root" --no-same-owner -xzf "$2"
    ;;

  *) die "geste refusé : $command" ;;
esac
