# Planification (ADR-008 D5) : sauvegardes, élagage, restaurations test,
# supervision, alertes. Lancée par partiduo-admin-schedule.timer.
[Unit]
Description=Partiduo — planification de l'administration

[Service]
Type=oneshot
User=partiduo-admin
EnvironmentFile=/etc/partiduo/admin.env
Environment=MARTEN_ENV=production
ExecStart=/opt/partiduo-admin/current/bin/partiduo-admin-manage schedule
